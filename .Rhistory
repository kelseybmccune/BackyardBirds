datum = read.csv(file.choose())  # Select WolfMorph.csv
head(datum)
# Load required libraries
library(MASS)      # for lda()
library(lattice)   # for splom()
splom(~data.frame(BodyLength, Mass, HFL, Ear),
data = datum,
groups = Animal,
auto.key = list(columns = 3))
library(car)
scatterplotMatrix(~BodyLength + Mass + HFL + Ear | Animal,
data = datum,
smooth = FALSE)
pairs(datum[,2:5], col = as.numeric(factor(datum$Animal)), pch = 19)
legend("topright", legend = levels(factor(datum$Animal)),
col = 1:3, pch = 19)
splom(~data.frame(BodyLength, Mass, HFL, Ear),
data = datum,
groups = Animal,
auto.key = list(columns = 3))
# Make sure Animal is a factor
datum$Animal = factor(datum$Animal)
# Run MANOVA
results_manova = manova(cbind(BodyLength, Mass, HFL, Ear) ~ Animal, data = datum)
summary(results_manova)
# Get univariate ANOVAs for each morphometric
summary.aov(results_manova)
results_dfa = lda(Animal ~ BodyLength + Mass + HFL + Ear, data = datum)
results_dfa
# Look at group means
results_dfa$means
# ============================================================
# Question 4: Describe the linear discriminants
# ============================================================
# Look at the coefficients (loadings) for each LD
results_dfa$scaling
# ============================================================
# Question 5: Proportion of trace (variance) explained by LD1
# ============================================================
# Calculate proportion of trace
results_dfa$svd^2 / sum(results_dfa$svd^2)
# ============================================================
# Question 6: Classification accuracy
# ============================================================
# Predict class membership for original data
predictions = predict(results_dfa)
# Create confusion matrix
confusion_matrix = table(Actual = datum$Animal, Predicted = predictions$class)
confusion_matrix
# Calculate overall accuracy
accuracy = sum(diag(confusion_matrix)) / sum(confusion_matrix)
accuracy
# Calculate error rate (proportion of mistakes)
error_rate = 1 - accuracy
error_rate
# Calculate accuracy by species
accuracy_by_species = diag(confusion_matrix) / rowSums(confusion_matrix)
accuracy_by_species
# ============================================================
# Question 7: Plot DFA results
# ============================================================
# Plot the discriminant functions
plot(results_dfa, col = as.numeric(datum$Animal))
# Alternative: More customized plot
# Extract LD scores
ld_scores = predict(results_dfa)$x
# Create plot
plot(ld_scores[,1], ld_scores[,2],
col = as.numeric(datum$Animal),
pch = 19,
xlab = "LD1",
ylab = "LD2",
main = "Discriminant Function Analysis of Canid Species")
legend("topright",
legend = levels(datum$Animal),
col = 1:3,
pch = 19)
# Add group centroids
centroids = aggregate(ld_scores, by = list(datum$Animal), FUN = mean)
points(centroids[,2], centroids[,3], pch = 4, cex = 2, lwd = 3)
