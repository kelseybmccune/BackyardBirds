filter(!is.na(Positive) & Species != "EnviroSample") %>%
mutate(
# Create meaningful labels for site conditions
Site_Type = case_when(
Exp.Condition == "CON" ~ "Control",
Exp.Condition == "BF" ~ "Bird Feeder",
Exp.Condition == "C" ~ "Chickens",
Exp.Condition == "BFC" ~ "Both",
TRUE ~ "Unknown"
),
# Create visit categories for easier interpretation
Visit_Category = case_when(
NumberVisits == 0 ~ "No RFID visits",
NumberVisits <= 5 ~ "Low activity (1-5)",
NumberVisits <= 20 ~ "Moderate activity (6-20)",
NumberVisits <= 100 ~ "High activity (21-100)",
TRUE ~ "Very high activity (>100)"
),
# Convert to factors with proper ordering
Visit_Category = factor(Visit_Category, levels = c("No RFID visits", "Low activity (1-5)",
"Moderate activity (6-20)", "High activity (21-100)",
"Very high activity (>100)")),
Disease_Status = ifelse(Positive == "Y", "Positive", "Negative")
)
# Print sample sizes for context
cat("Sample sizes by site condition:\n")
print(table(analysis_data$Site_Type))
cat("\nDisease prevalence by site condition:\n")
disease_prev <- analysis_data %>%
group_by(Site_Type, Disease_Status) %>%
summarise(count = n(), .groups = "drop") %>%
group_by(Site_Type) %>%
mutate(total = sum(count),
percentage = round((count/total)*100, 1)) %>%
filter(Disease_Status == "Positive")
print(disease_prev[,c("Site_Type", "percentage")])
# Main visualization: Disease status by site condition with RFID activity overlay
main_plot <- ggplot(analysis_data, aes(x = Site_Type, fill = Disease_Status)) +
geom_bar(position = "fill", color = "black", size = 0.3) +
scale_fill_manual(values = c("Negative" = "#4575b4", "Positive" = "#d73027")) +
scale_y_continuous(labels = scales::percent_format()) +
theme_bw() +
theme(
axis.text.x = element_text(size = 12, angle = 45, hjust = 1),
axis.text.y = element_text(size = 12),
axis.title = element_text(size = 14, face = "bold"),
legend.title = element_text(size = 12, face = "bold"),
legend.text = element_text(size = 11),
plot.title = element_text(size = 16, face = "bold", hjust = 0.5)
) +
labs(
x = "Site Condition",
y = "Proportion of Birds",
fill = "Disease Status",
title = "Disease Prevalence by Site Condition"
)
print(main_plot)
