# Additional visualizations for songbird RFID and disease analysis
# This extends your existing backyard_birds_copy.R script
# Load libraries (same as your existing script)
library(tidyverse)
library(ggplot2)
library(RColorBrewer)
library(GGally)
library(GGally)
library(GGally)
# Additional visualizations for songbird RFID and disease analysis
# This extends your existing backyard_birds_copy.R script
# Load libraries (same as your existing script)
library(tidyverse)
library(ggplot2)
library(RColorBrewer)
library(GGally)
# Additional visualizations for songbird RFID and disease analysis
# This extends your existing backyard_birds_copy.R script
# Load libraries (same as your existing script)
library(tidyverse)
library(ggplot2)
library(RColorBrewer)
library(GGally)
# Assuming you've already run the main script and have the merged data
# If not, uncomment and run the data loading sections from your main script
#### New Visualization 1: RFID Visits by Site Condition and Disease Status ####
# Create a comprehensive dataset for visualization
rfid_disease_data <- bbMaster[!is.na(bbMaster$Positive) & bbMaster$Species != "EnviroSample",]
rfid_disease_data$VisitCategory <- cut(rfid_disease_data$NumberVisits,
breaks = c(-1, 0, 5, 20, 100, Inf),
labels = c("No visits", "1-5 visits", "6-20 visits", "21-100 visits", ">100 visits"))
# Plot 1: Stacked bar chart showing visit patterns by site condition and disease status
p1 <- ggplot(rfid_disease_data, aes(x = Exp.Condition, fill = VisitCategory)) +
geom_bar(position = "fill") +
facet_wrap(~Positive, labeller = labeller(Positive = c("N" = "Disease Negative", "Y" = "Disease Positive"))) +
scale_fill_brewer(type = "seq", palette = "Blues") +
theme_bw() +
theme(
axis.text = element_text(size = 12),
axis.title = element_text(size = 14, face = "bold"),
strip.text = element_text(size = 12, face = "bold"),
legend.title = element_text(size = 12),
legend.text = element_text(size = 10)
) +
labs(
x = "Site Condition",
y = "Proportion of Birds",
fill = "RFID Visit Pattern",
title = "RFID Visit Patterns by Site Condition and Disease Status"
) +
scale_x_discrete(labels = c("CON" = "Control", "BF" = "Bird Feeder", "C" = "Chickens", "BFC" = "Both"))
print(p1)
#### New Visualization 2: Disease Prevalence by Site Condition (Enhanced) ####
# Create summary data for disease by site condition
disease_summary <- rfid_disease_data %>%
group_by(Exp.Condition, Positive) %>%
summarise(count = n(), .groups = "drop") %>%
group_by(Exp.Condition) %>%
mutate(
total = sum(count),
percentage = (count / total) * 100,
condition_label = case_when(
Exp.Condition == "CON" ~ "Control",
Exp.Condition == "BF" ~ "Bird Feeder",
Exp.Condition == "C" ~ "Chickens",
Exp.Condition == "BFC" ~ "Both"
)
)
# Plot 2: Bar chart showing disease prevalence by site condition
p2 <- ggplot(disease_summary, aes(x = condition_label, y = percentage, fill = Positive)) +
geom_bar(stat = "identity", position = "stack", color = "black", size = 0.3) +
scale_fill_manual(values = c("N" = "#e0e0e0", "Y" = "#d73027"),
labels = c("N" = "Negative", "Y" = "Positive")) +
theme_bw() +
theme(
axis.text = element_text(size = 12),
axis.title = element_text(size = 14, face = "bold"),
legend.title = element_text(size = 12),
legend.text = element_text(size = 10)
) +
labs(
x = "Site Condition",
y = "Percentage of Birds",
fill = "Disease Status",
title = "Disease Prevalence by Site Condition"
) +
geom_text(aes(label = paste0(round(percentage, 1), "%")),
position = position_stack(vjust = 0.5), size = 3.5)
print(p2)
#### New Visualization 3: RFID Visits vs Disease Status by Site Condition ####
# Plot 3: Boxplots showing visit patterns split by site condition and disease
p3 <- ggplot(rfid_disease_data, aes(x = Positive, y = log(NumberVisits + 1), fill = Positive)) +
geom_boxplot(alpha = 0.7) +
geom_jitter(width = 0.2, alpha = 0.5, size = 1) +
facet_wrap(~Exp.Condition, labeller = labeller(Exp.Condition = c("CON" = "Control",
"BF" = "Bird Feeder",
"C" = "Chickens",
"BFC" = "Both"))) +
scale_fill_manual(values = c("N" = "#4575b4", "Y" = "#d73027"),
labels = c("N" = "Negative", "Y" = "Positive")) +
scale_x_discrete(labels = c("N" = "Negative", "Y" = "Positive")) +
theme_bw() +
theme(
axis.text = element_text(size = 10),
axis.title = element_text(size = 12, face = "bold"),
strip.text = element_text(size = 11, face = "bold"),
legend.position = "none"
) +
labs(
x = "Disease Status",
y = "Log(RFID Visits + 1)",
title = "RFID Visit Frequency by Disease Status and Site Condition"
)
print(p3)
#### New Visualization 4: Pathogen-Specific Analysis ####
# Create data for pathogen-specific analysis
pathogen_data <- rfid_disease_data[!is.na(rfid_disease_data$BacResult),]
pathogen_data$BacResult <- factor(pathogen_data$BacResult,
levels = c("None", "E.Coli", "Salm", "Both"))
# Plot 4: Pathogen types by site condition
pathogen_summary <- pathogen_data %>%
group_by(Exp.Condition, BacResult) %>%
summarise(count = n(), .groups = "drop") %>%
group_by(Exp.Condition) %>%
mutate(
total = sum(count),
percentage = (count / total) * 100,
condition_label = case_when(
Exp.Condition == "CON" ~ "Control",
Exp.Condition == "BF" ~ "Bird Feeder",
Exp.Condition == "C" ~ "Chickens",
Exp.Condition == "BFC" ~ "Both"
)
)
p4 <- ggplot(pathogen_summary, aes(x = condition_label, y = percentage, fill = BacResult)) +
geom_bar(stat = "identity", position = "stack", color = "black", size = 0.3) +
scale_fill_manual(values = c("None" = "#f0f0f0", "E.Coli" = "#fdae61",
"Salm" = "#d73027", "Both" = "#a50026"),
labels = c("None" = "No pathogens", "E.Coli" = "E. coli only",
"Salm" = "Salmonella only", "Both" = "Both pathogens")) +
theme_bw() +
theme(
axis.text = element_text(size = 12),
axis.title = element_text(size = 14, face = "bold"),
legend.title = element_text(size = 12),
legend.text = element_text(size = 10),
legend.position = "bottom"
) +
labs(
x = "Site Condition",
y = "Percentage of Birds",
fill = "Pathogen Status",
title = "Pathogen Detection by Site Condition"
)
print(p4)
#### New Visualization 5: Site-level RFID Activity Summary ####
# Create site-level summary data
site_summary <- bbDet.o %>%
group_by(Site, Condition) %>%
summarise(
total_detections = sum(AntennaNum, na.rm = TRUE),
unique_birds = length(unique(Bird)),
detection_rate = total_detections / unique_birds,
.groups = "drop"
)
# Plot 5: Site-level detection patterns (with outlier removed for better visualization)
# Remove extreme outlier to make the majority of data more readable
# Note: One site with ~1800 detections has been filtered out to improve readability
site_summary_filtered <- site_summary %>%
filter(total_detections < 1500)  # Remove the extreme outlier visible in your plot
cat("\nNote: Removed", nrow(site_summary) - nrow(site_summary_filtered), "extreme outlier(s) from site-level plot for better visualization\n")
p5 <- ggplot(site_summary_filtered, aes(x = unique_birds, y = total_detections, color = Condition, size = detection_rate)) +
geom_point(alpha = 0.7) +
scale_color_manual(values = c("BF" = "#2166ac", "BFC" = "#762a83"),
labels = c("BF" = "Bird Feeder", "BFC" = "Bird Feeder + Chickens")) +
scale_size_continuous(name = "Detections\nper Bird", range = c(2, 8)) +
theme_bw() +
theme(
axis.text = element_text(size = 12),
axis.title = element_text(size = 14, face = "bold"),
legend.title = element_text(size = 12),
legend.text = element_text(size = 10)
) +
labs(
x = "Number of Unique Birds Detected",
y = "Total RFID Detections",
color = "Site Condition",
title = "RFID Detection Activity by Site (Outlier Removed for Clarity)"
)
print(p5)
#### Save combined plot ####
library(gridExtra)
# Create a combined plot showing key relationships
combined_plot <- grid.arrange(p2, p3, ncol = 2,
top = "Songbird Disease Status and RFID Activity by Site Condition")
# You can save any of these plots using ggsave(), for example:
# ggsave("disease_by_site_condition.png", p2, width = 10, height = 6, dpi = 300)
# ggsave("rfid_disease_combined.png", combined_plot, width = 15, height = 8, dpi = 300)
#### Additional summary statistics ####
cat("\n=== SUMMARY STATISTICS ===\n")
cat("\nDisease prevalence by site condition:\n")
print(disease_summary %>%
filter(Positive == "Y") %>%
select(condition_label, percentage) %>%
arrange(desc(percentage)))
cat("\nMean RFID visits by site condition and disease status:\n")
visit_summary <- rfid_disease_data %>%
group_by(Exp.Condition, Positive) %>%
summarise(
mean_visits = mean(NumberVisits, na.rm = TRUE),
median_visits = median(NumberVisits, na.rm = TRUE),
n_birds = n(),
.groups = "drop"
)
print(visit_summary)
cat("\nPathogen detection summary:\n")
pathogen_summary_table <- pathogen_data %>%
group_by(Exp.Condition) %>%
summarise(
n_tested = n(),
n_negative = sum(BacResult == "None"),
n_ecoli = sum(BacResult == "E.Coli"),
n_salm = sum(BacResult == "Salm"),
n_both = sum(BacResult == "Both"),
.groups = "drop"
)
print(pathogen_summary_table)
View(site_summary_filtered)
# Plot 5: Site-level detection patterns (with outlier removed for better visualization)
# Remove extreme outlier to make the majority of data more readable
# Note: One site with ~1800 detections has been filtered out to improve readability
site_summary_filtered <- site_summary %>%
filter(total_detections < 1500)  # Remove the extreme outlier visible in your plot
cat("\nNote: Removed", nrow(site_summary) - nrow(site_summary_filtered), "extreme outlier(s) from site-level plot for better visualization\n")
p5 <- ggplot(site_summary_filtered, aes(x = unique_birds, y = total_detections, color = Condition, size = detection_rate)) +
geom_point(alpha = 0.7) +
scale_color_manual(values = c("BF" = "#2166ac", "BFC" = "#762a83"),
labels = c("BF" = "Bird Feeder", "BFC" = "Bird Feeder + Chickens")) +
scale_size_continuous(name = "Detections\nper Bird", range = c(2, 8)) +
theme_bw() +
theme(
axis.text = element_text(size = 12),
axis.title = element_text(size = 14, face = "bold"),
legend.title = element_text(size = 12),
legend.text = element_text(size = 10)
) +
labs(
x = "Number of Individual Birds Detected",
y = "Total RFID Detections",
color = "Site Condition",
title = "RFID Detection Activity by Site (Outlier Removed for Clarity)"
)
print(p5)
# Plot 5: Site-level detection patterns (with outlier removed for better visualization)
# Remove extreme outlier to make the majority of data more readable
# Note: One site with ~1800 detections has been filtered out to improve readability
site_summary_filtered <- site_summary %>%
filter(total_detections < 1500)  # Remove the extreme outlier visible in your plot
cat("\nNote: Removed", nrow(site_summary) - nrow(site_summary_filtered), "extreme outlier(s) from site-level plot for better visualization\n")
p5 <- ggplot(site_summary_filtered, aes(x = unique_birds, y = total_detections, color = Condition, size = detection_rate)) +
geom_point(alpha = 0.7) +
scale_color_manual(values = c("BF" = "#2166ac", "BFC" = "#762a83"),
labels = c("BF" = "Bird Feeder", "BFC" = "Bird Feeder + Chickens")) +
scale_size_continuous(name = "Detections\nper Bird", range = c(2, 8)) +
# Use integer breaks since you can't have fractional birds
scale_x_continuous(breaks = seq(0, max(site_summary_filtered$unique_birds), by = 1)) +
theme_bw() +
theme(
axis.text = element_text(size = 12),
axis.title = element_text(size = 14, face = "bold"),
legend.title = element_text(size = 12),
legend.text = element_text(size = 10)
) +
labs(
x = "Number of Unique Birds Detected",
y = "Total RFID Detections",
color = "Site Condition",
title = "RFID Detection Activity by Site (Outlier Removed for Clarity)"
)
print(p5)
source("~/Downloads/key_visualization_example.R")
