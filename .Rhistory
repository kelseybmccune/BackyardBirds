# Run PCA (without scaling as instructed)
PCA = princomp(morph_data)
summary(PCA)
PCA$loadings
# Visualize the loadings
print(PCA$loadings)
# Option 1: Add scores to datum dataframe
datum$PC1 = PCA$scores[,1]
datum$PC2 = PCA$scores[,2]
datum$PC3 = PCA$scores[,3]
