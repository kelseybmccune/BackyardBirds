filter(total_detections < 1500)  # Remove the extreme outlier visible in your plot
#### New Visualization 5: Site-level RFID Activity Summary ####
# Create site-level summary data
site_summary <- bbDet.o %>%
group_by(Site, Condition) %>%
summarise(
total_detections = sum(AntennaNum, na.rm = TRUE),
unique_birds = length(unique(Bird)),
detection_rate = total_detections / unique_birds,
.groups = "drop"
)
# Plot 5: Site-level detection patterns (with outlier removed for better visualization)
# Remove extreme outlier to make the majority of data more readable
# Note: One site with ~1800 detections has been filtered out to improve readability
site_summary_filtered <- site_summary %>%
filter(total_detections < 1500)  # Remove the extreme outlier visible in your plot
cat("\nNote: Removed", nrow(site_summary) - nrow(site_summary_filtered), "extreme outlier(s) from site-level plot for better visualization\n")
p5 <- ggplot(site_summary_filtered, aes(x = unique_birds, y = total_detections, color = Condition, size = detection_rate)) +
geom_point(alpha = .7) +
scale_color_manual(values = c("BF" = "#8FA369", "BFC" = "#2C4B81"),
labels = c("BF" = "Bird Feeder", "BFC" = "Bird Feeder + Chickens")) +
scale_size_continuous(name = "Detections\nper Bird", range = c(6, 20)) +
# Use integer breaks since you can't have fractional birds
scale_x_continuous(breaks = seq(0, max(site_summary_filtered$unique_birds), by = 1)) +
theme_bw() +
theme(
axis.text = element_text(size = 16),
axis.title = element_text(size = 18),
legend.title = element_text(size = 18),
legend.text = element_text(size = 16),
plot.title = element_text(size = 16, face = "bold", hjust = 0.5)
) +
labs(
x = "Number of Unique Birds Detected",
y = "Total RFID Detections",
color = "Site Condition",
title = "RFID Detection Activity by Site"
)
print(p5)
