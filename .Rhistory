"log_exotic_mammals", "log_area")])))
# Remove rows with any missing values
clean_data <- na.omit(bird_data[, c("log_extinctions", "log_colonization",
"log_exotic_mammals", "log_area","log_isolation")])
print("Clean data summary:")
summary(clean_data)
print(paste("Number of complete cases:", nrow(clean_data)))
# Updated SEM model specification
model <- specifyModel(text = "
log_extinctions <- log_colonization, path1
log_extinctions <- log_exotic_mammals, path2
log_extinctions <- log_area, path3
log_extinctions <- log_isolation, path4
log_exotic_mammals <- log_colonization, path5
log_exotic_mammals <- log_isolation, path6
log_colonization <-> log_colonization, var_col
log_area <-> log_area, var_area
log_isolation <-> log_isolation, var_iso
log_colonization <-> log_area, cov_col_area
log_colonization <-> log_isolation, cov_col_iso
log_area <-> log_isolation, cov_area_iso
")
# Run SEM with clean data
results <- sem(model, data = clean_data)
# View results
summary(results)
nrow(clean_data)
