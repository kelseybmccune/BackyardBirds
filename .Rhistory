exp(confint(results2))
library(dagitty)
# Define the DAG (already provided)
DAG = dagitty('dag{
TreeDens [pos="0,3"]
SoilComp [pos="1,3.5"]
SoilMoist [pos="1.5,2.5"]
Sun [pos="1.5,2.0"]
Under [pos="3,3"]
TreeDens->Sun->Under
TreeDens->SoilMoist->Under
TreeDens->Under
TreeDens->SoilComp->Under
SoilComp->SoilMoist
}')
# Plot the DAG to visualize
plot(DAG)
# Part a: Find adjustment sets for TOTAL effect of SoilMoist on Under
adjustmentSets(DAG, exposure="SoilMoist", outcome="Under", effect="total")
# Part b: Run the linear model for total effect
# (Use the variables from adjustmentSets output)
results3b = lm(Under ~ SoilMoist + SoilComp, data=datum)
summary(results3b)
confint(results3b)
# Part c: Test if DeerDens is a confounder
# Model WITHOUT DeerDens (from part b)
model_without_deer = lm(Under ~ SoilMoist + SoilComp, data=datum)
summary(model_without_deer)
# Model WITH DeerDens
model_with_deer = lm(Under ~ SoilMoist + SoilComp + DeerDens, data=datum)
summary(model_with_deer)
# Compare the SoilMoist coefficients
coef(model_without_deer)["SoilMoist"]
coef(model_with_deer)["SoilMoist"]
# Calculate percent change in coefficient
percent_change = ((coef(model_with_deer)["SoilMoist"] - coef(model_without_deer)["SoilMoist"]) /
coef(model_without_deer)["SoilMoist"]) * 100
percent_change
# Part d: Model selection using stepwise AIC
# Start with full model (all DAG variables)
full_model = lm(Under ~ TreeDens + SoilComp + SoilMoist + Sun, data=datum)
# Stepwise selection
library(MASS)
best_model = stepAIC(full_model, direction="both")
summary(best_model)
# Alternative: Compare all possible models manually
model1 = lm(Under ~ TreeDens + SoilComp + SoilMoist + Sun, data=datum)
model2 = lm(Under ~ TreeDens + SoilComp + SoilMoist, data=datum)
model3 = lm(Under ~ TreeDens + SoilMoist + Sun, data=datum)
model4 = lm(Under ~ SoilComp + SoilMoist + Sun, data=datum)
model5 = lm(Under ~ TreeDens + SoilComp + Sun, data=datum)
# ... etc
# Compare AICs
AIC(model1, model2, model3, model4, model5)
# Select only the morphometric variables
morph_data = datum[, c("ChestGirth", "Weight", "BodyLength", "AntlerSize")]
# Run PCA WITHOUT scaling (cor=FALSE means use covariance matrix, not correlation)
results_pca = princomp(morph_data, cor=FALSE)
# Summary of PCA
summary(results_pca)
# Part a: Proportion of variance explained by PC2
summary(results_pca)$sdev^2 / sum(summary(results_pca)$sdev^2)
# Or more directly:
prop_var = (results_pca$sdev^2) / sum(results_pca$sdev^2)
prop_var  # Look at the 2nd value for PC2
# Part b: Loadings for Weight and AntlerSize on PC2
results_pca$loadings
# Or more specifically:
results_pca$loadings[, 2]  # All loadings for PC2
results_pca$loadings["Weight", "Comp.2"]      # Weight loading on PC2
results_pca$loadings["AntlerSize", "Comp.2"]  # AntlerSize loading on PC2
library(mvtnorm)
library(survminer)
library(coxme)
library(tidyverse)
library(gdata)
library(ggplot2)
library(GGally)
library(psych)
library(RColorBrewer)
library(lme4)
library(multcomp)
# Download data as .csv from Google Drive. Load the data into R
setwd("/Users/alex/Desktop")# set working directory to GitHub folder where you store the files
setwd("/Users/alex/Documents/GitHub/BackyardBirds")
bbDet.o = read.csv("BBDetections.csv") # load RFID data
bbBio.o = read.csv("BBBiometrics.csv") # load biometrics
BBDisOld.o = read.csv("BBFecalOld.csv")
BBDisNew.o = read.csv("BBFecal.csv")
## Total number of visits per bird
# Create a new data frame that sums the 1s in AntennaNum column to count the number of visits for each specific bird
bbDetSum = aggregate(AntennaNum ~ Bird + Condition, FUN = "sum", data = bbDet.o)
# Change column names to make it easier to understand
colnames(bbDetSum) = c("PitID","Condition","NumberVisits")
## Look at the distribution of visits
# most birds visit between 1 & 50 times
hist(bbDetSum$NumberVisits, xlab = "Number of visits", cex.lab = 1.5, cex.axis = 1.3)
# only detections from BF & BFC sites. Number of visits looks similar, though BF has more variation
boxplot(bbDetSum$NumberVisits ~ bbDetSum$Condition)
bbMaster.o = bbBio.o[,-c(2:5,10,13:14,24:27)]
colnames(bbMaster.o)[c(2,3)] = c("USGS", "PitID")
bbMaster = merge(bbMaster.o, bbDetSum, by = "PitID", all = T)
bbMaster = bbMaster[-which(bbMaster$PitID == "RECAP" | is.na(bbMaster$Species)),]
bbMaster$NumberVisits[which(is.na(bbMaster$NumberVisits))]<-0
bbMaster$PitID[which(is.na(bbMaster$PitID))]<- "NonTarget"
## Total number of visits per household
# Create a new data frame that sums the 1s in AntennaNum column to count the number of visits for each household
SiteDetSum = aggregate(AntennaNum ~ Site, FUN = "sum", data = bbDet.o)
# Change column names to make it easier to understand
colnames(SiteDetSum)[2] = "NumberVisits"
## Look at the distribution of visits
hist(SiteDetSum$NumberVisits, xlab = "Number of visits", cex.lab = 1.5, cex.axis = 1.3)
plot(SiteDetSum$NumberVisits ~ as.factor(SiteDetSum$Site))
## Total birds detected per household
SBDetSum = aggregate(AntennaNum ~ Site + Bird + Condition, FUN = "sum", data = bbDet.o)
SBDetSum$olre = 1:nrow(SBDetSum)
SBDetSum$count = 1
SBDetSum2 = aggregate(count ~ Site, FUN = "sum", data = SBDetSum) # number of individuals detected at each house
#### This is the model for poster dot plot figure ####
m = glmer(AntennaNum ~ Condition + (1|Site) + (1|olre), family = "poisson", data = SBDetSum)
summary(m)
##### Disease #####
BBDisOld = BBDisOld.o[which(BBDisOld.o$Test == "Chromo Plate"),c(2:3,5:6)]
BBDisNew = BBDisNew.o[,c(1:2,9:10)]
colnames(BBDisOld) = c("USGS","Date","Positive","BacResult")
colnames(BBDisNew) = c("Date","USGS","Positive","BacResult")
BBDis = rbind(BBDisOld,BBDisNew)
BBDis$BacResult[which(is.na(BBDis$BacResult))]<-"None"
table(BBDis$BacResult)
BBDis$Positive[which(BBDis$Positive == "N ")]<-"N"
bbMaster2 = merge(BBDis, bbMaster, by = "USGS", all = T)
bbMaster2$Species[which(is.na(bbMaster2$Species))] <- "EnviroSample"
table(bbMaster2$Positive) # 80 N, 320 Y = 20% infected with Salm and/or E. coli
table(is.na(bbMaster2$Positive)) # Fecals processed for 79% of captures
table(bbMaster2$Species[which(bbMaster2$Positive == "Y")]) # NOCA-13, CARW-13, TUTI-7
boxplot(log(bbMaster2$NumberVisits+1) ~ bbMaster2$Positive) # more visits, less positive?
bbMaster2$Exp.Condition = factor(bbMaster2$Exp.Condition, levels = c("CON","BF","C","BFC")) # reorder factor levels so CON is baseline
bbMaster2$Salm = ifelse(bbMaster2$BacResult == "None" | bbMaster2$BacResult == "E.Coli","No","Yes") # a column that indicates if sample had salmonella
bbMaster2$Salm = ifelse(bbMaster2$BacResult == "", "No", bbMaster2$Salm)
table(bbMaster2$Salm, bbMaster2$Exp.Condition)
det.data = bbMaster2[-which(bbMaster2$Species == "EnviroSample" | is.na(bbMaster2$Positive)),]
det.data$olre = 1:nrow(det.data) # poisson models are overdispersed otherwise
det.m <- glmer(NumberVisits ~ Salm + (1|Species) + (1|Household) + (1|olre),
data = det.data, family = "poisson")
summary(det.m) # no differences - birds with bacterial infections were not detected more at the feeders
### Except in the slightly overdispersed Poisson model, probability of infection is unrelated to frequency of detection by RFID
det.data$Salm = as.factor(det.data$Salm)
det.data$Salm = factor(det.data$Salm, levels = c("No", "Yes"),
labels = c("Negative","Positive"))
ggplot(det.data[which(det.data$NumberVisits>0),], aes(x = Salm, y = NumberVisits, fill = Salm))+
geom_boxplot()+
scale_fill_manual(values = c("Negative" = "#8FA369", "Positive" = "#2C4B81")) +
theme_bw() +
theme(
axis.text.x = element_text(size = 15, angle = 45, hjust = 1),
axis.text.y = element_text(size = 15),
axis.title = element_text(size = 17, face = "bold"),
strip.text = element_text(size = 17, face = "bold"),
legend.title = element_text(size = 15),
legend.text = element_text(size = 14),
plot.title = element_text(size = 20, face = "bold", hjust = 0.5)
) +
labs(
x = "S. enterica Detected",
y = "Number of Visits to Food",
fill = "Infection Status",
title = "RFID Detections vs Pathogen Pressure")
det.m3 <- glmer(NumberVisits ~ binPos3 + (1|Species) + (1|Household) + (1|olre),
data = det.data, family = "poisson")
summary(det.m3) # just e.coli, no signficant effect
bbMaster2$Exp.Condition = factor(bbMaster2$Exp.Condition, levels = c("CON","BF","C","BFC")) # reorder factor levels so CON is baseline
# Create the key dataset for analysis
analysis_data <- bbMaster2 %>%
filter(!is.na(Positive) & Species != "EnviroSample" & Exp.Condition %in% c("CON","BF","C","BFC")) %>%
mutate(
# Create meaningful labels for site conditions
Site_Type = case_when(
Exp.Condition == "CON" ~ "Control",
Exp.Condition == "BF" ~ "Bird Feeder",
Exp.Condition == "C" ~ "Chickens",
Exp.Condition == "BFC" ~ "Both",
TRUE ~ "Unknown"
),
# Create visit categories for easier interpretation
Visit_Category = case_when(
NumberVisits == 0 ~ "No RFID visits",
NumberVisits <= 5 ~ "Low activity (1-5)",
NumberVisits <= 20 ~ "Moderate activity (6-20)",
NumberVisits <= 100 ~ "High activity (21-100)",
TRUE ~ "Very high activity (>100)"
),
# Convert to factors with proper ordering
Visit_Category = factor(Visit_Category, levels = c("No RFID visits", "Low activity (1-5)",
"Moderate activity (6-20)", "High activity (21-100)",
"Very high activity (>100)")),
Disease_Status = ifelse(Positive == "Y", "Positive", "Negative")
)
# Print sample sizes for context
cat("Sample sizes by site condition:\n")
print(table(analysis_data$Site_Type))
cat("\nDisease prevalence by site condition:\n")
disease_prev <- analysis_data %>%
group_by(Site_Type, Disease_Status) %>%
summarise(count = n(), .groups = "drop") %>%
group_by(Site_Type) %>%
mutate(total = sum(count),
percentage = round((count/total)*100, 1)) %>%
filter(Disease_Status == "Positive")
print(disease_prev[,c("Site_Type", "percentage")])
# Main visualization: Disease status by site condition with RFID activity overlay
analysis_data$Site_Type = factor(analysis_data$Site_Type, levels = c("Control","Bird Feeder","Chickens","Both")) # reorder factor levels so CON is baseline
main_plot <- ggplot(analysis_data, aes(x = Site_Type, fill = Disease_Status)) +
geom_bar(position = "fill", color = "black", linewidth = 0.3) +
scale_fill_manual(values = c("Negative" = "#8FA369", "Positive" = "#2C4B81")) +
scale_y_continuous(labels = scales::percent_format()) +
theme_bw() +
theme(
axis.text.x = element_text(size = 15, angle = 45, hjust = 1),
axis.text.y = element_text(size = 15),
axis.title = element_text(size = 17),
legend.title = element_text(size = 17),
legend.text = element_text(size = 15),
plot.title = element_text(size = 20, face = "bold", hjust = 0.5)
) +
labs(
x = "Site Condition",
y = "Proportion of Birds",
fill = "Disease Status",
title = "Disease Prevalence by Site Condition"
)
print(main_plot)
